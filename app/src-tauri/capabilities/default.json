{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the history, result and settings webviews may call. The pasteboard, the global shortcuts, paste simulation, context capture and Core are driven from Rust and need no webview permission.",
  "windows": [
    "history",
    "result",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "x-apple.systempreferences:*"
        }
      ]
    },
    "clipboard-manager:allow-write-text",
    "dialog:allow-save",
    "store:default",
    "autostart:default",
    "positioner:default"
  ]
}
